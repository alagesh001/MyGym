<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <!-- Gradient Background -->
            <gradient
                android:angle="0"
                android:startColor="#FF7864"
                android:endColor="#F6A03B"
                android:type="linear"/>

            <!-- Rounded Corners -->
            <corners android:radius="20dp"/>

        </shape>
    </item>
</layer-list>
