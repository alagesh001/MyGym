<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background color -->
    <solid android:color="@color/white" />

    <!-- Border color and thickness -->
    <stroke
        android:width="2dp"
        android:color="@color/gray" />

    <!-- Rounded corners -->
    <corners android:radius="16dp" />

    <!-- Padding inside the input -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>