<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Main Item (Always Visible) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/item_viewcard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/_15sdp"
        >
<RelativeLayout
    android:id="@+id/relative_lay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp"
    android:background="@color/tertiary_color"

    >

        <ImageView
            android:id="@+id/imgProfile"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:scaleType="centerCrop"
            android:background="@drawable/circle_shape"
            android:visibility="gone"
            android:padding="2dp" />
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rakesh Sharma"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:padding="10dp"
            android:layout_toRightOf="@id/imgProfile"

           />

</RelativeLayout>

    </androidx.cardview.widget.CardView>


    <!-- Expandable Section (Initially Hidden) -->
    <RelativeLayout
        android:id="@+id/expandableLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="visible"
        android:layout_marginTop="-40dp"
        android:background="#7BCDBCA8">
        <TextView
            android:id="@+id/update_tv"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_30sdp"
            android:text="Edit"

            android:textAlignment="center"
            android:backgroundTint="@color/primary_color"
            android:textColor="@color/blue_700"
            android:padding="@dimen/_10sdp"
        android:layout_alignParentEnd="true"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginTop="@dimen/_30sdp"

            android:orientation="horizontal"
            android:padding="@dimen/_10sdp">

            <ImageView
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:background="@drawable/baseline_call_24"
                android:backgroundTint="@color/primary_color" />

            <TextView
                android:id="@+id/tvDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/_5sdp"
                android:text="Mobile"
                android:textColor="@color/primary_color"
                android:textSize="16sp" />
        </LinearLayout>

    </RelativeLayout>
</LinearLayout>
