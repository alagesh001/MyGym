<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_gravity="center"
    android:background="@color/white"
    >
<ScrollView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:paddingVertical="@dimen/_20sdp"
android:layout_gravity="center"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >


    <!-- Name Field -->
    <TextView
        android:id="@+id/name_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Name"
        android:textColor="@color/primary_color"
        android:textStyle="bold"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/name_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Name"
        android:textColor="@color/black"
        android:textColorHint="#ADADAD"
        android:backgroundTint="@color/tertiary_color"
        android:inputType="textPersonName" />

        <!-- Paid Months Field -->
        <LinearLayout
            android:id="@+id/edit_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">
            <!-- Mobile Field -->
            <TextView
                android:id="@+id/mob_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mobile"
                android:textSize="16sp"
                android:textColor="@color/primary_color"

                android:textStyle="bold" />

            <EditText
                android:id="@+id/mob_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Mobile Number"
                android:textColor="@color/black"
                android:textColorHint="#ADADAD"

                android:inputType="phone" />

            <!-- Email Field -->

            <TextView
                android:id="@+id/email_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textSize="16sp"
                android:textColor="@color/primary_color"

                android:textStyle="bold" />

            <EditText
                android:id="@+id/email_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Email Address"
                android:textColor="@color/black"
                android:textColorHint="#ADADAD"

                android:inputType="textEmailAddress" />
            <TextView
                android:id="@+id/refer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Referral Id"
                android:textStyle="bold"
                android:textColor="@color/primary_color"

                android:textSize="16sp" />

            <EditText
                android:id="@+id/refer_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Referral Id"
                android:textColor="@color/black"
                android:textColorHint="#ADADAD"

                android:inputType="text" />
            <TextView
                android:id="@+id/dob_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date of birth"
                android:textSize="16sp"
                android:textColor="@color/primary_color"

                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDateOfBirth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select Date of Birth"
                android:textColor="@color/black"
                android:textColorHint="#ADADAD"

                android:focusable="false" />

            <TextView
                android:id="@+id/height_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Height (in cm)"
                android:textSize="16sp"
                android:textColor="@color/primary_color"

                android:textStyle="bold" />

            <EditText
                android:id="@+id/height_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Height"
                android:textColor="@color/black"
                android:textColorHint="#ADADAD"

                android:inputType="numberDecimal" />

            <TextView
                android:id="@+id/weight_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weight (in kg)"
                android:textSize="16sp"
                android:textColor="@color/primary_color"

                android:textStyle="bold" />

            <EditText
                android:id="@+id/weight_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textColorHint="#ADADAD"

                android:hint="Enter Weight"
                android:inputType="numberDecimal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/goaltv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Goal"
                        android:textSize="16sp"
                        android:textColor="@color/primary_color"

                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinner_type"
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/goaltv"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/custom_spinner"
                        android:entries="@array/user_types"
                        android:padding="@dimen/_5sdp" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gender"
                        android:textSize="16sp"
                        android:textColor="@color/primary_color"

                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinner_type_gender"
                        android:layout_width="@dimen/_100sdp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="25dp"
                        android:background="@drawable/custom_spinner"

                        android:padding="@dimen/_5sdp" />
                </RelativeLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Trainer"
                android:textSize="16sp"
                android:textColor="@color/primary_color"

                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_type_trainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/custom_spinner"
                android:padding="@dimen/_5sdp"

                />

        </LinearLayout>

        <LinearLayout
        android:id="@+id/renew_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp"

        android:visibility="visible"
        >

    <TextView
        android:id="@+id/paidmonths_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Paid Months"
        android:textStyle="bold"
        android:textColor="@color/primary_color"

        android:textSize="16sp" />

    <EditText
        android:id="@+id/paidmonths_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:textColorHint="#ADADAD"

        android:hint="Enter Number of Paid Months"
        android:inputType="number" />
    <TextView
        android:id="@+id/frm_date_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="From Date"
        android:textStyle="bold"
        android:textColor="@color/primary_color"

        android:textSize="16sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="5dp">

        <DatePicker
            android:id="@+id/datePicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:datePickerMode="spinner"
            android:theme="@style/CustomDatePickerTheme"
            android:calendarViewShown="false"/>
        <TextView
            android:id="@+id/textViewSelectedDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:layout_marginTop="@dimen/_5sdp"
            android:visibility="gone"
            android:text="" />
    </LinearLayout>
            <TextView
                android:id="@+id/total_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Amount to be paid"
                android:textStyle="bold"
                android:textColor="@color/primary_color"

                android:textSize="16sp" />

            <EditText
                android:id="@+id/total_amount_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textColorHint="#ADADAD"

                android:hint="Enter the amount to be paid"
                android:inputType="number" />
            <TextView
                android:id="@+id/amount_paid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Amount paid"
                android:textStyle="bold"
                android:textColor="@color/primary_color"

                android:textSize="16sp" />

            <EditText
                android:id="@+id/amount_paid_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter the amount paid"
                android:textColor="@color/black"
                android:textColorHint="#ADADAD"
                android:inputType="number" />
            <TextView
                android:id="@+id/due_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Due amount:"
                android:textStyle="bold"
                android:textColor="@color/red"
                android:textSize="16sp" />
    </LinearLayout>

    <!-- Submit Button -->
    <Button
        android:id="@+id/renew_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Renew"
        android:layout_marginTop="@dimen/_10sdp"
        android:backgroundTint="#E40212"
        android:layout_gravity="center"
        android:textColor="@color/white"

        android:visibility="gone"
        />
    <Button
        android:id="@+id/submit_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add"
        android:textColor="@color/white"

        android:layout_marginTop="@dimen/_10sdp"
        android:backgroundTint="@color/secondary_color"
        android:layout_gravity="center" />
    <Button
        android:id="@+id/update_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Update"
        android:visibility="gone"
        android:layout_marginTop="@dimen/_10sdp"
        android:backgroundTint="@color/secondary_color"
        android:textColor="@color/white"

        android:layout_gravity="center" />
    <Button
        android:id="@+id/delete_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Delete"
        android:textColor="@color/white"
        android:layout_marginTop="@dimen/_10sdp"
        android:backgroundTint="@color/tertiary_color"
        android:visibility="gone"
        android:layout_gravity="center" />
    </LinearLayout>

</ScrollView>

</LinearLayout>
