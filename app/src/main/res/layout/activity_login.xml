<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.Login"
    android:background="@color/white">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/registerLay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@color/white"
        android:visibility="visible"
        >
        <TextView
            android:id="@+id/titleRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="New Register"
            android:textColor="@color/primary_color"
            android:textStyle="bold"
            android:textSize="30sp"
            android:textAlignment="center"
            android:layout_marginTop="@dimen/_60sdp"
            app:layout_constraintTop_toTopOf="parent"
            />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/titleRegister"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Owner Name -->
            <EditText
                android:id="@+id/et_owner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Owner Name"
                android:textColorHint="@color/gray"
                android:textColor="@color/primary_color"
                android:layout_marginVertical="@dimen/_10sdp"
                android:inputType="textPersonName"/>

            <!-- Gym Name -->
            <EditText
                android:id="@+id/et_gym_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Gym Name"
                android:layout_marginVertical="@dimen/_10sdp"
                android:textColorHint="@color/gray"
                android:textColor="@color/primary_color"

                android:inputType="text"/>

            <!-- Location -->
            <EditText
                android:id="@+id/et_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Location"
                android:layout_marginVertical="@dimen/_10sdp"
                android:textColorHint="@color/gray"
                android:textColor="@color/primary_color"

                android:inputType="text"/>

            <!-- Mobile Number -->
            <EditText
                android:id="@+id/et_mobile_register"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Mobile Number"
                android:layout_marginVertical="@dimen/_10sdp"
                android:textColorHint="@color/gray"
                android:textColor="@color/primary_color"

                android:inputType="phone"
             />

            <!-- Email -->
            <EditText
                android:id="@+id/et_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email"
                android:layout_marginVertical="@dimen/_10sdp"
                android:textColorHint="@color/gray"
                android:textColor="@color/primary_color"

                android:inputType="textEmailAddress"/>

            <!-- Subscription Months -->
            <EditText
                android:id="@+id/et_months"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Subscription Months"
                android:layout_marginVertical="@dimen/_10sdp"
                android:textColorHint="@color/gray"
                android:textColor="@color/primary_color"

                android:inputType="number"/>

            <!-- Submit Button -->
            <Button
                android:id="@+id/btn_submit"
                android:layout_width="match_parent"
                android:layout_marginVertical="@dimen/_10sdp"
                android:backgroundTint="@color/secondary_color"
                android:layout_height="wrap_content"
                android:text="Submit"/>
            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="match_parent"
                android:backgroundTint="@color/fourth_color"
                android:layout_height="wrap_content"
                android:text="Cancel"/>

        </LinearLayout>

    </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/loginLay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    android:background="@color/black"
    android:visibility="gone"
    >

    <ImageView
        android:id="@+id/bg_viewLogin"
    android:layout_width="0dp"
    android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:alpha="0.8"
        android:adjustViewBounds="true"
app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"

    />
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"


        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        />
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        android:clipChildren="true"
        android:clipToPadding="true"
        app:cardBackgroundColor="@color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        >
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80FFFFFF"
        android:elevation="5dp"
        android:radius="@dimen/_25sdp"
        android:padding="16dp"
        />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center_vertical"
android:paddingHorizontal="@dimen/_30sdp"
            android:elevation="8dp"
            android:paddingVertical="@dimen/_60sdp"
            >
            <eightbitlab.com.blurview.BlurView
                android:id="@+id/blur_mobile"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_glass"
               >

                <EditText
                    android:id="@+id/et_mobile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Mobile"
                    android:textColorHint="@color/gray_dahomerk"
                    android:background="@android:color/transparent"
                    android:textColor="#1B1B1B"
                    android:textSize="16sp"
                    android:drawableLeft="@drawable/phone_icn"
                    android:inputType="number"
                    android:drawablePadding="15dp"
                    android:paddingStart="40dp"/>
            </eightbitlab.com.blurview.BlurView>

            <eightbitlab.com.blurview.BlurView
                android:id="@+id/blur_password"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_glass"
              >

                <EditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Password"
                    android:textColorHint="@color/gray_dahomerk"
                    android:background="@android:color/transparent"
                    android:textColor="#1B1B1B"
                    android:textSize="16sp"
                    android:inputType="textPassword"
                    android:drawableLeft="@drawable/baseline_password_24"
                    android:drawablePadding="15dp"
                    android:paddingStart="40dp"/>
            </eightbitlab.com.blurview.BlurView>

                <Button
                    android:id="@+id/btn_login"
                    android:layout_width="@dimen/_150sdp"
                    android:layout_height="match_parent"
                    android:text="LOGIN"
                    android:textColor="#FFFFFF"
                    android:enabled="false"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:textSize="@dimen/_13ssp"
                    android:layout_gravity="center_horizontal"
                    android:backgroundTint="#4CAF50"/>
            <Button
                android:id="@+id/btn_register"
                android:layout_width="@dimen/_150sdp"
                android:layout_height="match_parent"
                android:text="NEW REGISTER"
                android:textColor="#FFFFFF"
                android:layout_marginTop="@dimen/_10sdp"
                android:textSize="@dimen/_13ssp"
                android:layout_gravity="center_horizontal"
                android:backgroundTint="@color/fourth_color"/>
        </LinearLayout>

    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>