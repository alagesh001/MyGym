<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
  >

<!--    <com.oxad.fitox.utils.DarkBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>-->
    <EditText
        android:id="@+id/editTextReferral"
        android:layout_width="0dp"
        android:layout_height="@dimen/_200sdp"
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:textColor="@color/black"
        android:background="@drawable/roun_rad_rect"
        android:backgroundTint="#DEDEDE"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:textColorHint="#4D4D4D"
        android:padding="@dimen/_15sdp"
        android:hint="Enter your broadcast message here"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/buttonSave"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/secondary_color"
android:textColor="@color/white"
        android:text="Set Broadcast message"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.516"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editTextReferral" />
</androidx.constraintlayout.widget.ConstraintLayout>
