<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MyClientFragment"
    android:background="@color/white">

    <!-- Top Filter Buttons -->
    <LinearLayout
        android:id="@+id/filter_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center"
        android:layout_marginTop="@dimen/_30sdp"
        android:elevation="4dp"
       >

        <Button
            android:id="@+id/btn_trainer"
            android:layout_width="@dimen/_120sdp"

            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/_10sdp"
            android:backgroundTint="@color/secondary_color"
            android:paddingVertical="@dimen/_10sdp"
            android:scaleX="1.1"

            android:scaleY="1.1"
            android:text="Admins"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btn_dietician"
            android:layout_width="@dimen/_120sdp"
            android:layout_height="wrap_content"
            android:text="Dietician"
            android:visibility="gone"
            android:textSize="20sp"
            android:paddingVertical="@dimen/_10sdp"
            android:layout_marginLeft="@dimen/_10sdp"

            android:backgroundTint="@color/gray"
            android:textColor="@color/black" />
    </LinearLayout>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/filter_buttons"
        android:layout_marginTop="@dimen/_15sdp"
         /> <!-- Space for buttons -->
    <LinearLayout
        android:id="@+id/dietician_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/filter_buttons"
        android:padding="16dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/roun_rad_rect"
        android:backgroundTint="@color/gray"
        android:elevation="4dp"
        android:visibility="gone">

        <!-- Dietician Name -->
        <TextView
            android:id="@+id/dietician_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name: Not set"
            android:textSize="17sp"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <!-- Dietician ID -->
        <TextView
            android:id="@+id/dietician_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ID: -"
            android:layout_marginStart="@dimen/_8sdp"
            android:textSize="15sp"
            android:textColor="@color/black"
            android:layout_marginTop="10dp" />

        <!-- Password Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_passworld_field"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/password_input"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="•••••••••"
                android:textColor="@color/black"
                android:textColorHint="#ADADAD"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/toggle_password"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/eye_off"
                android:contentDescription="Show/Hide Password"
                android:padding="4dp" />
        </LinearLayout>
    </LinearLayout>


</RelativeLayout>
