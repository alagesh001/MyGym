<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/_10sdp"
 android:orientation="vertical"

    >
<LinearLayout
    android:id="@+id/card_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/roun_rad_rect"
    android:backgroundTint="@color/tertiary_color"
    android:orientation="horizontal"
    android:elevation="1dp"
    android:padding="16dp">


    <!-- Incrementing Number -->
    <TextView
        android:id="@+id/numberTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="1"
        android:textSize="16sp"
        android:textColor="@color/white"

        android:textStyle="bold" />

    <!-- Name -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name"
            android:textColor="@color/white"

            android:textSize="16sp"
            android:textStyle="bold" />


    </LinearLayout>


    <!-- Mobile -->


    <!-- Renewal Date -->
    <TextView
        android:id="@+id/tvRenewalDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Renewal Date"
        android:textColor="@color/white"

        android:textSize="16sp" />
</LinearLayout>
    <RelativeLayout
        android:id="@+id/expandableLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:visibility="visible"
        android:layout_marginTop="-40dp"
        android:background="#7BCDBCA8"
        >
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="40dp"

            >
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center"
    >
    <ImageView
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:background="@drawable/baseline_call_24"
        android:backgroundTint="@color/primary_color"/>
        <TextView
            android:id="@+id/tvMobile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3589893493"
            android:paddingHorizontal="@dimen/_5sdp"
            android:textColor="@color/primary_color"
            android:textSize="16sp"
            android:paddingVertical="@dimen/_5sdp"
            />
</LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            >
            <ImageView
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:background="@drawable/baseline_star_purple500_24"
                android:backgroundTint="@color/primary_color"/>
            <TextView
            android:id="@+id/tvGoal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weight Loss"
            android:textColor="@color/primary_color"
            android:textSize="16sp"
                android:paddingHorizontal="@dimen/_5sdp"

                android:paddingVertical="@dimen/_5sdp"

            />
        </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                >
                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:visibility="gone"

                    android:background="@drawable/baseline_star_purple500_24"
                    android:backgroundTint="@color/primary_color"/>
                <TextView
                    android:id="@+id/tvAttendCount"
                    android:layout_width="@dimen/_120sdp"
                    android:layout_height="wrap_content"
                    android:text="Attendance - "
                    android:textColor="@color/primary_color"
                    android:textSize="16sp"
                    android:paddingHorizontal="@dimen/_5sdp"

                    android:paddingVertical="@dimen/_5sdp"

                    />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                >
                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:visibility="gone"
                    android:background="@drawable/baseline_star_purple500_24"
                    android:backgroundTint="@color/primary_color"/>
                <TextView
                    android:id="@+id/tvlastAttend"
                    android:layout_width="@dimen/_120sdp"
                    android:layout_height="wrap_content"
                    android:text="Last attended "
                    android:textColor="@color/primary_color"
                    android:textSize="16sp"
                    android:paddingHorizontal="@dimen/_5sdp"

                    android:paddingVertical="@dimen/_5sdp"

                    />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentEnd="true"
            android:gravity="end"

            >

        <TextView
            android:id="@+id/update_tv"
            android:layout_width="@dimen/_90sdp"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Edit"

            android:textAlignment="center"
            android:backgroundTint="@color/primary_color"
            android:textColor="@color/white"
            android:padding="@dimen/_10sdp"

            android:background ="@drawable/roun_rad_rect"
            android:textSize="16sp" />


            <TextView
                android:id="@+id/renew_tv"
                android:layout_width="@dimen/_90sdp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Renew"
                android:textAlignment="center"
                android:backgroundTint="@color/primary_color"
                android:textColor="@color/white"
                android:padding="@dimen/_10sdp"

                android:background ="@drawable/roun_rad_rect"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/due_tv"
                android:layout_width="@dimen/_90sdp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Due Pay"
                android:visibility="gone"
                android:textAlignment="center"
                android:backgroundTint="@color/red"
                android:textColor="@color/white"
                android:padding="@dimen/_10sdp"

                android:background ="@drawable/roun_rad_rect"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/diet_schedule_tv"
                android:layout_width="@dimen/_120sdp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Diet Schedule"
                android:textAlignment="center"
                android:backgroundTint="#9C27B0"
                android:textColor="@color/white"
                android:padding="@dimen/_10sdp"

                android:background ="@drawable/roun_rad_rect"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/sendwtsapp_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Send Referral Code"
                android:textAlignment="center"
                android:backgroundTint="@color/blue_700"
                android:textColor="@color/white"
                android:padding="@dimen/_10sdp"

                android:background ="@drawable/roun_rad_rect"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- <TextView
             android:id="@+id/tvDetails"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:text="Expanded Details Here"

             android:textColor="@color/black"
             android:textSize="16sp"
          />-->
    </RelativeLayout>
</LinearLayout>
