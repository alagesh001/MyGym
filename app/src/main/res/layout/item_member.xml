<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/_10sdp"
 android:orientation="vertical"

    >
<LinearLayout
    android:id="@+id/card_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/roun_rad_rect"
    android:backgroundTint="@color/tertiary_color"
    android:orientation="horizontal"
    android:elevation="1dp"
    android:padding="16dp">


    <!-- Incrementing Number -->
    <TextView
        android:id="@+id/numberTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="1"
        android:textSize="16sp"
        android:textColor="@color/white"

        android:textStyle="bold" />

    <!-- Name -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name"
            android:textColor="@color/white"

            android:textSize="16sp"
            android:textStyle="bold" />


    </LinearLayout>


    <!-- Mobile -->


    <!-- Renewal Date -->
    <TextView
        android:id="@+id/tvRenewalDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Renewal Date"
        android:textColor="@color/white"

        android:textSize="16sp" />
</LinearLayout>
    <RelativeLayout
        android:id="@+id/expandableLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:visibility="visible"
        android:layout_marginTop="-40dp"
        android:background="#7BCDBCA8"
        >
        <LinearLayout
            android:id="@+id/ll_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="40dp"

            >
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center"
    >
    <ImageView
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:background="@drawable/baseline_call_24"
        android:backgroundTint="@color/tertiary_color"/>
        <TextView
            android:id="@+id/tvMobile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3589893493"
            android:paddingHorizontal="@dimen/_5sdp"
            android:textColor="@color/primary_color"
            android:textSize="16sp"
            android:paddingVertical="@dimen/_5sdp"
            />
</LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            >
            <ImageView
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:background="@drawable/target_vct"
                android:backgroundTint="@color/tertiary_color"/>
            <TextView
            android:id="@+id/tvGoal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weight Loss"
            android:textColor="@color/primary_color"
            android:textSize="16sp"
                android:paddingHorizontal="@dimen/_5sdp"

                android:paddingVertical="@dimen/_5sdp"

            />
        </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                >
                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:visibility="gone"

                    android:background="@drawable/baseline_star_purple500_24"
                    android:backgroundTint="@color/primary_color"/>
                <TextView
                    android:id="@+id/tvAttendCount"
                    android:layout_width="@dimen/_120sdp"
                    android:layout_height="wrap_content"
                    android:text="Attendance - "
                    android:textColor="@color/primary_color"
                    android:textSize="16sp"
                    android:paddingHorizontal="@dimen/_5sdp"

                    android:paddingVertical="@dimen/_5sdp"

                    />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/lastattend_ll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                >
                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:visibility="gone"
                    android:background="@drawable/baseline_star_purple500_24"
                    android:backgroundTint="@color/primary_color"/>
                <TextView
                    android:id="@+id/tvlastAttend"
                    android:layout_width="@dimen/_120sdp"
                    android:layout_height="wrap_content"
                    android:text="Last attended "
                    android:textColor="@color/primary_color"
                    android:textSize="16sp"
                    android:paddingHorizontal="@dimen/_5sdp"

                    android:paddingVertical="@dimen/_5sdp"

                    />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_contact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="40dp"
            android:layout_alignParentEnd="true"
            >
            <ImageView
                android:id="@+id/call_btn"
                android:layout_width="40sp"
                android:layout_height="40sp"
                android:src="@drawable/telephone"
           />

            <ImageView
                android:id="@+id/wtapp_btn"
                android:layout_width="40sp"
                android:layout_height="40sp"
                android:layout_marginTop="@dimen/_10sdp"
                android:src="@drawable/social"
             />


        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_below="@+id/ll_details"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/update_tv"
                    style="@style/ActionButtonHorizontal"
                    android:text="Edit" />

                <TextView
                    android:id="@+id/renew_tv"
                    style="@style/ActionButtonHorizontal"
                    android:text="Renew" />

                <TextView
                    android:id="@+id/due_tv"
                    style="@style/ActionButtonHorizontal"
                    android:text="Due Pay"
                    android:visibility="gone"
                    android:backgroundTint="@color/red" />

                <TextView
                    android:id="@+id/diet_schedule_tv"
                    style="@style/ActionButtonHorizontal"
                    android:text="Diet Schedule"
                    android:backgroundTint="#9C27B0" />

                <TextView
                    android:id="@+id/sendwtsapp_tv"
                    style="@style/ActionButtonHorizontal"
                    android:text="Share Detail"
                    android:backgroundTint="@color/blue_700" />
            </LinearLayout>
        </HorizontalScrollView>


        <!-- <TextView
             android:id="@+id/tvDetails"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:text="Expanded Details Here"

             android:textColor="@color/black"
             android:textSize="16sp"
          />-->
    </RelativeLayout>
</LinearLayout>
