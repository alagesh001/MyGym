<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_10sdp"
    android:layout_marginVertical="@dimen/_10sdp"
 android:orientation="vertical"

    >
<LinearLayout
    android:id="@+id/card_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/roun_rad_rect"
    android:backgroundTint="@color/green"
    android:orientation="horizontal"
    android:elevation="1dp"
    android:padding="16dp">


    <!-- Incrementing Number -->
    <TextView
        android:id="@+id/numberTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="1"
        android:textSize="16sp"
        android:textColor="@color/white"

        android:textStyle="bold" />

    <!-- Name -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name"
            android:textColor="@color/white"

            android:textSize="16sp"
            android:textStyle="bold" />


    </LinearLayout>


    <!-- Mobile -->


    <!-- Renewal Date -->
    <TextView
        android:id="@+id/tvRenewalDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Renewal Date"
        android:textColor="@color/white"

        android:textSize="16sp" />
</LinearLayout>
    <RelativeLayout
        android:id="@+id/expandableLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:visibility="visible"
        android:layout_marginTop="-40dp"
        android:background="#E4E4E4"
        >
        <TextView
            android:id="@+id/tvMobile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Mobile"
            android:textSize="16sp" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentEnd="true"
            android:gravity="end"

            >

        <TextView
            android:id="@+id/update_tv"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Edit"
            android:textAlignment="center"
            android:backgroundTint="#3F51B5"
            android:textColor="@color/white"
            android:padding="@dimen/_10sdp"

            android:background ="@drawable/roun_rad_rect"
            android:textSize="16sp" />
            <TextView
                android:id="@+id/renew_tv"
                android:layout_width="@dimen/_60sdp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Renew"
                android:textAlignment="center"
                android:backgroundTint="#3F51B5"
                android:textColor="@color/white"
                android:padding="@dimen/_10sdp"

                android:background ="@drawable/roun_rad_rect"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/sendwtsapp_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Send Referral Code"
                android:textAlignment="center"
                android:backgroundTint="#3F51B5"
                android:textColor="@color/white"
                android:padding="@dimen/_10sdp"

                android:background ="@drawable/roun_rad_rect"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- <TextView
             android:id="@+id/tvDetails"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:text="Expanded Details Here"

             android:textColor="@color/black"
             android:textSize="16sp"
          />-->
    </RelativeLayout>
</LinearLayout>
