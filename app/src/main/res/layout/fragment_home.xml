<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:background="@color/transparent"
    android:orientation="vertical">
   <!-- <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        />-->
<ImageView
    android:id="@+id/bg_viewIv"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:alpha="0.6"
    android:visibility="visible"
app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    android:scaleType="centerCrop"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/_20sdp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/_40sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"

            >

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/welcometitle"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_toLeftOf="@+id/settings_iv"
                android:textSize="25sp"/>
            <ImageView
                android:id="@+id/settings_iv"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:background="@drawable/setting_icon"
                android:backgroundTint="@color/white"
                android:layout_alignParentEnd="true"
                android:layout_marginLeft="@dimen/_12sdp"
                />
        </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/_30sdp"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintBottom_toBottomOf="parent">
        <RelativeLayout
            android:id="@+id/myclients_rl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:elevation="2dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/myclients_iv"
android:alpha="0.8"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_70sdp"
                android:background="@drawable/rounded_rect_grad"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="My Clients"
                android:paddingHorizontal="@dimen/_20sdp"

                android:textColor="@color/white"
                android:textSize="@dimen/_15ssp"
                android:layout_centerVertical="true"
                />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                >


    <ImageView
        android:id="@+id/clientadd_iv"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:src="@drawable/person_add"
        android:background="@drawable/circle_shape"

        android:layout_marginHorizontal="@dimen/_20sdp"
        android:padding="@dimen/_5sdp"

        />
            </LinearLayout>


        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/mytrainer_rl"

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="2dp"
            android:layout_marginTop="@dimen/_10sdp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_70sdp"
                android:background="@drawable/rounded_rect_grad2"
                android:alpha="0.8"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="Trainer/Dietician"
                android:paddingHorizontal="@dimen/_20sdp"

                android:textColor="@color/white"
                android:textSize="@dimen/_15ssp"
                android:layout_centerVertical="true"
                />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                >


                <ImageView
                    android:id="@+id/traineradd_iv"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:src="@drawable/person_add"
                    android:background="@drawable/circle_shape"

                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:padding="@dimen/_5sdp"

                    />
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/searchfilter_rl"

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="2dp"
            android:layout_marginTop="@dimen/_10sdp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_70sdp"
                android:background="@drawable/rounded_rect_grad3"
                android:alpha="0.8"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="Search Filter"
                android:paddingHorizontal="@dimen/_20sdp"

                android:textColor="@color/white"
                android:textSize="@dimen/_15ssp"
                android:layout_centerVertical="true"
                />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                >



            </LinearLayout>

        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/myrefer_rl"

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="2dp"
            android:layout_marginTop="@dimen/_10sdp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_70sdp"
                android:background="@drawable/rounded_rect_grad4"
                android:alpha="0.8"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="Broadcast Message"
                android:paddingHorizontal="@dimen/_20sdp"

                android:textColor="@color/white"
                android:textSize="@dimen/_15ssp"
                android:layout_centerVertical="true"
                />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                >



            </LinearLayout>

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/product_add"

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="2dp"
            android:layout_marginTop="@dimen/_10sdp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_70sdp"
                android:background="@drawable/rounded_rect_grad7"
                android:alpha="0.8"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="-1dp"

                android:layout_marginTop="33dp"
                android:paddingHorizontal="@dimen/_20sdp"
                android:text="Add Products"
                android:textColor="@color/white"
                android:textSize="@dimen/_15ssp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                >



            </LinearLayout>

        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/virtual_coach"

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="2dp"
            android:layout_marginTop="@dimen/_10sdp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_70sdp"
                android:background="@drawable/rounded_rect_grad5"
                android:alpha="0.8"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="-1dp"

                android:layout_marginTop="33dp"
                android:paddingHorizontal="@dimen/_20sdp"
                android:text="Virtual Coach"
                android:textColor="@color/white"
                android:textSize="@dimen/_15ssp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                >



            </LinearLayout>

        </RelativeLayout>
    </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
