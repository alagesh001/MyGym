<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:background="@color/black"
    android:orientation="vertical">
<ImageView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:src="@drawable/gym_pic"
    android:alpha="0.6"
    android:scaleType="centerCrop"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/_20sdp">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/welcometitle"
        android:textStyle="bold"
        android:paddingHorizontal="@dimen/_20sdp"
        android:textColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/_40sdp"
        android:textSize="25sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/_30sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintBottom_toBottomOf="parent">
        <RelativeLayout
            android:id="@+id/myclients_rl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:elevation="2dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/myclients_iv"
android:alpha="0.8"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_70sdp"
                android:background="@drawable/rounded_rect_grad"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="My Clients"
                android:paddingHorizontal="@dimen/_20sdp"

                android:textColor="@color/white"
                android:textSize="@dimen/_15ssp"
                android:layout_centerVertical="true"
                />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                >


    <ImageView
        android:id="@+id/clientadd_iv"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:src="@drawable/person_add"
        android:background="@drawable/circle_shape"

        android:layout_marginHorizontal="@dimen/_20sdp"
        android:padding="@dimen/_5sdp"

        />
            </LinearLayout>


        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/mytrainer_rl"

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="2dp"
            android:layout_marginTop="@dimen/_10sdp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_70sdp"
                android:background="@drawable/rounded_rect_grad2"
                android:alpha="0.8"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="My Trainers"
                android:paddingHorizontal="@dimen/_20sdp"

                android:textColor="@color/white"
                android:textSize="@dimen/_15ssp"
                android:layout_centerVertical="true"
                />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                >


                <ImageView
                    android:id="@+id/traineradd_iv"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:src="@drawable/person_add"
                    android:background="@drawable/circle_shape"

                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:padding="@dimen/_5sdp"

                    />
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/searchfilter_rl"

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="2dp"
            android:layout_marginTop="@dimen/_10sdp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_70sdp"
                android:background="@drawable/rounded_rect_grad3"
                android:alpha="0.8"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="Search Filter"
                android:paddingHorizontal="@dimen/_20sdp"

                android:textColor="@color/white"
                android:textSize="@dimen/_15ssp"
                android:layout_centerVertical="true"
                />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                >


                <ImageView
                    android:id="@+id/productadd_iv"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:src="@drawable/person_add"
                    android:background="@drawable/circle_shape"

                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:padding="@dimen/_5sdp"

                    />
            </LinearLayout>

        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/myrefer_rl"

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="2dp"
            android:layout_marginTop="@dimen/_10sdp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_70sdp"
                android:background="@drawable/rounded_rect_grad4"
                android:alpha="0.8"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="Referrals"
                android:paddingHorizontal="@dimen/_20sdp"

                android:textColor="@color/white"
                android:textSize="@dimen/_15ssp"
                android:layout_centerVertical="true"
                />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                >


                <ImageView
                    android:id="@+id/offeradd_iv"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:src="@drawable/person_add"
                    android:background="@drawable/circle_shape"

                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:padding="@dimen/_5sdp"

                    />
            </LinearLayout>

        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/complaint_rl"

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="2dp"
            android:layout_marginTop="@dimen/_10sdp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_70sdp"
                android:background="@drawable/rounded_rect_grad5"
                android:alpha="0.8"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="My Gym Profile"
                android:paddingHorizontal="@dimen/_20sdp"

                android:textColor="@color/white"
                android:textSize="@dimen/_15ssp"
                android:layout_centerVertical="true"
                />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                >



            </LinearLayout>

        </RelativeLayout>
    </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
