<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:padding="@dimen/_20sdp"
    android:background="@color/white"
    android:orientation="vertical">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/welcometitle"
        android:textStyle="bold"
        android:paddingHorizontal="@dimen/_20sdp"
        android:textColor="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/_15sdp"
        android:textSize="25sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/_30sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <RelativeLayout
            android:id="@+id/goaltrack_rl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:elevation="2dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/goaltrack_iv"

                android:layout_width="match_parent"
                android:layout_height="@dimen/_70sdp"
                android:background="@drawable/rounded_rect_grad"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="Goal Tracker"
                android:paddingHorizontal="@dimen/_20sdp"

                android:textColor="@color/white"
                android:textSize="@dimen/_15ssp"
                android:layout_centerVertical="true"
                />

        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/mytrainer_rl"

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="2dp"
            android:layout_marginTop="@dimen/_10sdp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_70sdp"
                android:background="@drawable/rounded_rect_grad2"

                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="My Trainer"
                android:paddingHorizontal="@dimen/_20sdp"

                android:textColor="@color/white"
                android:textSize="@dimen/_15ssp"
                android:layout_centerVertical="true"
                />


        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/ourproducts_rl"

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="2dp"
            android:layout_marginTop="@dimen/_10sdp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_70sdp"
                android:background="@drawable/rounded_rect_grad3"

                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="Our Products"
                android:paddingHorizontal="@dimen/_20sdp"

                android:textColor="@color/white"
                android:textSize="@dimen/_15ssp"
                android:layout_centerVertical="true"
                />


        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/myoffers_rl"

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="2dp"
            android:layout_marginTop="@dimen/_10sdp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_70sdp"
                android:background="@drawable/rounded_rect_grad4"

                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="Offers"
                android:paddingHorizontal="@dimen/_20sdp"

                android:textColor="@color/white"
                android:textSize="@dimen/_15ssp"
                android:layout_centerVertical="true"
                />


        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/complaint_rl"

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="2dp"
            android:layout_marginTop="@dimen/_10sdp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/_70sdp"
                android:background="@drawable/rounded_rect_grad5"

                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="Complaint"
                android:paddingHorizontal="@dimen/_20sdp"

                android:textColor="@color/white"
                android:textSize="@dimen/_15ssp"
                android:layout_centerVertical="true"
                />


        </RelativeLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
