<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/gymSelectFragment">

    <fragment
        android:id="@+id/gymSelectFragment"
        android:name="com.oxad.mygym.ui.GymSelectFragment"
        tools:layout="@layout/fragment_gym_select">

        <action
            android:id="@+id/action_gymSelectFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.oxad.mygym.ui.HomeFragment"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_profileFragment3"
            app:destination="@id/profileFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.oxad.mygym.ui.ProfileFragment"
        tools:layout="@layout/fragment_profile"/>

</navigation>
